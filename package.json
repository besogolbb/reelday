{
  "name": "reelday",
  "version": "1.0.0",
  "description": "Filipino event QR photo and video sharing platform",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "launch-check": "node scripts/launch-check.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:pre": "node scripts/perf.mjs pre",
    "perf:full": "node scripts/perf.mjs full",
    "perf:health": "node scripts/perf.mjs health",
    "perf:local": "node scripts/perf.mjs local",
    "perf:spot-local": "BASE_URL=http://localhost:3000 node scripts/perf.mjs spot",
    "perf:pre-local": "BASE_URL=http://localhost:3000 node scripts/perf.mjs pre",
    "perf:full-local": "BASE_URL=http://localhost:3000 node scripts/perf.mjs full"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1083.0",
    "@aws-sdk/client-lambda": "^3.1083.0",
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/client-sqs": "^3.1083.0",
    "@aws-sdk/s3-request-presigner": "^3.1083.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.3.0",
    "@remotion/lambda-client": "^4.0.487",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "openai": "^4.50.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "resend": "^6.17.2",
    "uuid": "^11.1.1"
  }
}
