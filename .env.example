DATABASE_URL=postgresql://user:password@localhost:5432/reelday
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reelday-uploads
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
PAYMONGO_SECRET_KEY=sk_test_XXXX
PAYMONGO_PUBLIC_KEY=pk_test_XXXX
JWT_SECRET=change-me-in-production
# Admin password for /admin. Leave blank to disable the admin panel entirely.
# Used as a shared secret over the wire (Bearer token), so make it long and random.
ADMIN_TOKEN=
GOOGLE_CLIENT_ID=

# ── Google Calendar sync (admin events → a shared calendar) ──
# Service account writes events into the calendar you shared with it
# ("Make changes to events"). All three required to enable; leave blank
# to disable (the .ics feed still works). See backend/lib/gcal.js.
# Backfill existing events once: node scripts/gcal-backfill.mjs
GOOGLE_CALENDAR_SA_EMAIL=
# Paste the JSON key's private_key value verbatim, keeping the literal
# \n escapes, wrapped in double quotes. NEVER commit the real value.
GOOGLE_CALENDAR_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

RESEND_API_KEY=re_XXXX
# Public host used in calendar event links + QR codes (no scheme).
APP_PUBLIC_HOST=reelday.ph
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# AWS — used for SQS-fronted Lambda video transcoding.
# Backend needs sqs:SendMessage on the queue ARN. Leave TRANSCODE_SQS_URL blank to fall
# back to direct Lambda async invoke (legacy behavior).
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSCODE_SQS_URL=https://sqs.ap-southeast-1.amazonaws.com/263842074067/reelday-transcode.fifo
TRANSCODE_LAMBDA_NAME=reelday-transcoder-v3-singapore
