DATABASE_URL=postgresql://user:password@localhost:5432/reelday
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reelday-uploads
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
PAYMONGO_SECRET_KEY=sk_test_XXXX
PAYMONGO_PUBLIC_KEY=pk_test_XXXX
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
RESEND_API_KEY=re_XXXX
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# AWS — used for SQS-fronted Lambda video transcoding.
# Backend needs sqs:SendMessage on the queue ARN. Leave TRANSCODE_SQS_URL blank to fall
# back to direct Lambda async invoke (legacy behavior).
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSCODE_SQS_URL=https://sqs.ap-southeast-1.amazonaws.com/263842074067/reelday-transcode.fifo
TRANSCODE_LAMBDA_NAME=reelday-transcoder-v3-singapore
